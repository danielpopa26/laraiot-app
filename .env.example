# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME="LaraIoT App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Port exposed on the host machine for HTTP traffic
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration (MariaDB Container)
# -----------------------------------------------------------------------------
# DB_HOST refers to the Docker service name 'mariadb'
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laraiot
DB_USERNAME=laraiot_user
DB_PASSWORD=secret

# Optional: Host port mapping for external tools (TablePlus, DBeaver, etc.)
# FORWARD_DB_PORT=3307

# -----------------------------------------------------------------------------
# Session, Cache & Queue Drivers
# -----------------------------------------------------------------------------
# Database cache store is recommended to share health heartbeats across containers
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# LaraIoT Package Settings
# -----------------------------------------------------------------------------
# Supported modes: "polling" or "websocket"
LARAIOT_MODE=websocket
LARAIOT_UI_ENABLED=true
LARAIOT_UI_PREFIX=laraiot

# -----------------------------------------------------------------------------
# MQTT Broker Settings (Mosquitto Container)
# -----------------------------------------------------------------------------
# Host refers to the Docker service name 'mqtt-broker'
LARAIOT_MQTT_HOST=mqtt-broker
LARAIOT_MQTT_PORT=1883
LARAIOT_MQTT_CLIENT_ID=laraiot-client
LARAIOT_MQTT_LISTENER_CLIENT_ID=laraiot-listener
LARAIOT_MQTT_USERNAME=
LARAIOT_MQTT_PASSWORD=
LARAIOT_MQTT_CLEAN_SESSION=true
LARAIOT_MQTT_KEEP_ALIVE=10

# -----------------------------------------------------------------------------
# Laravel Reverb (WebSockets)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=laraiot-app
REVERB_APP_KEY=laraiot-key
REVERB_APP_SECRET=laraiot-secret

# Internal Reverb host for container-to-container health monitor
REVERB_SERVER_HOST=0.0.0.0
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Client-facing WebSocket configuration for Vite / Inertia frontend
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8085
VITE_REVERB_SCHEME=http